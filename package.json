{
  "name": "dsh-wechat-emoji",
  "version": "0.1.0",
  "description": "让 DSH agent 识别微信/QQ 表情包与聊天截图并判断对方情绪（GLM-4V-Flash），暴露 wechat_emoji_analyze 工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "emoji",
    "emotion",
    "vision"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
